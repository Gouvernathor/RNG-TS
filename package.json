{
  "name": "@gouvernathor/rng",
  "version": "1.2.1",
  "description": "A deterministic and reseedable random number generator, resembling (but not with the same API as) Python's Random.",
  "type": "module",
  "main": "RNG.js",
  "types": "RNG.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/RNG.d.ts",
        "default": "./dist/RNG.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node tests",
    "asbuild:debug": "asc assembly/index.ts --target debug",
    "asbuild:release": "asc assembly/index.ts --target release",
    "asbuild": "npm run asbuild:debug && npm run asbuild:release",
    "start": "npx serve ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gouvernathor/rng-ts.git"
  },
  "keywords": [
    "rng"
  ],
  "author": "Gouvernathor",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Gouvernathor/rng-ts/issues"
  },
  "homepage": "https://github.com/Gouvernathor/rng-ts#readme",
  "devDependencies": {
    "assemblyscript": "^0.27.35",
    "tsup": "^8.3.5",
    "typescript": "*"
  }
}