{
    "name": "@gouvernathor/rng",
    "version": "1.5.0",
    "description": "A deterministic and reseedable random number generator, resembling (but not with the same API as) Python's Random.",
    "type": "module",
    "main": "RNG.js",
    "types": "RNG.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/RNG.d.ts",
                "default": "./dist/RNG.js"
            }
        },
        "./bigint": {
            "import": {
                "types": "./dist/bigint/RNG.d.ts",
                "default": "./dist/bigint/RNG.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Gouvernathor/rng-ts.git"
    },
    "keywords": [
        "rng"
    ],
    "author": "Gouvernathor",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Gouvernathor/rng-ts/issues"
    },
    "homepage": "https://github.com/Gouvernathor/rng-ts#readme",
    "devDependencies": {
        "@tsconfig/strictest": "^2.0.8",
        "typescript": "*"
    },
    "dependencies": {
        "@gouvernathor/fraction.ts": "^1.1.0"
    }
}
